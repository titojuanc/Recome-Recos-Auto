# Variables del cron (ver specs/001-cron-carga-usuarios/contracts/entorno.md).
# Los valores son de ejemplo y NO son secretos reales.

# --- Obligatorias ---
API_GENERAL_BASE_URL=http://localhost:8080/api/v1
API_GENERAL_API_KEY=local.cambiar-por-la-clave-real
RABBITMQ_URL=amqp://guest:guest@localhost:5672/

# --- Opcionales (valores por defecto) ---
RUN_SCHEDULE=0 12 * * *
RUN_TIMEZONE=America/Argentina/Buenos_Aires
MODULE_REFERENCE_DATE=2026-10-05
API_GENERAL_PAGE_SIZE=200
API_GENERAL_TIMEOUT_S=10
API_GENERAL_MAX_RETRIES=3
API_GENERAL_RETRY_BACKOFF_S=1
API_GENERAL_MAX_PAGES=1000
RABBITMQ_USERS_QUEUE=recos-auto.usuarios
RABBITMQ_DELIVERY_LIMIT=5
RABBITMQ_USERS_MESSAGE_TTL_MS=7200000
RABBITMQ_DEAD_LETTER_TTL_MS=604800000
PUBLISH_MAX_RETRIES=3
PUBLISH_RETRY_BACKOFF_S=0.5
MAX_CONSECUTIVE_PUBLISH_FAILURES=5
LOG_LEVEL=INFO

# --- Worker (feature 002) ---
RABBITMQ_QUEUE_NOTIFICACIONES=notificaciones
WORKER_CONCURRENCY=4
PUBLISH_CONFIRM_TIMEOUT_S=10
BREAKER_FAILURES=5
BREAKER_BACKOFF_S=1
BREAKER_BACKOFF_MAX_S=60
BREAKER_MAX_HOLD_S=1500
SHUTDOWN_TIMEOUT_S=25
SUMMARY_INTERVAL_S=60
WORKER_POLL_S=1
